sequenceDiagram
    actor Application
    participant Operator
    participant Ecologist
    participant Dispatcher
    participant Measure
    participant Event

    Application->>Operator: new Operator("Іван Петренко", "ST001")
    Application->>Ecologist: new Ecologist("Марія Коваленко", "Зона A")
    Application->>Dispatcher: new Dispatcher("Петро Сидоренко", "emergency@dsns.gov.ua")

    Application->>Application: "=== Початок моніторингу ===" (вивід)
    Application->>Operator: monitor()
    Operator-->>Application: завершення monitor()

    Application->>Measure: new Measure(150.0)
    Application->>Ecologist: checkExcess(measure)
    Ecologist-->>Application: true / false

    alt перевищення норм (true)
        Application->>Application: "Виявлено перевищення норм!" (вивід)
        Application->>Event: new Event("Перевищення ГДК", measure)
        Application->>Dispatcher: receiveAlert(event)
        Dispatcher-->>Application: завершення receiveAlert()
    else немає перевищення
        Application->>Application: без виклику Dispatcher.receiveAlert()
    end

    Application->>Ecologist: planService()
    Ecologist-->>Application: завершення planService()

    Application->>Operator: report()
    Operator-->>Application: завершення report()

    Application->>Application: "=== Кінець моніторингу ===" (вивід)
